{
  "name": "@fellesdatakatalog/fdk-labs",
  "version": "1.0.0",
  "description": "Agent Skills Framework for Claude Code",
  "license": "Apache-2.0",
  "devDependencies": {
    "archiver": "^7.0.1",
    "skills": "1.5.3"
  },
  "scripts": {
    "skills:add": "skills add ./agent-skills/skills && node scripts/link-skills.mjs",
